{
  "name": "kinlog-functions",
  "private": true,
  "description": "Locked In server: wallet sign-in, workout attestation, crank and daily jobs (Cloud Functions for Firebase).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs --tests && node --enable-source-maps --test \".test-build/unit/**/*.test.js\"",
    "test:emulator": "node build.mjs --tests && node --enable-source-maps --test --test-concurrency=1 \".test-build/emulator/**/*.test.js\"",
    "script": "node tools/run.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "typescript": "5.9.3"
  }
}
