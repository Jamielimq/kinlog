{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@solana/web3.js": ["./node_modules/@solana/web3.js"],
      "@solana/spl-token": ["./node_modules/@solana/spl-token"]
    }
  },
  "include": ["src", "test", "tools", "scripts"]
}
